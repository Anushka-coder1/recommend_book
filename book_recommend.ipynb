   "source": [
    "# Popularity based Recommendation System"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 60,
   "metadata": {
    "colab": {
     "base_uri": "https://localhost:8080/",
     "height": 408
    },
    "id": "NuLUhnd8Cq07",
    "outputId": "cf734d76-fec6-443c-d6d6-7b59a9cbc619"
   },
   "outputs": [],
   "source": [
    "average_rating = book_ratings.groupby('Book-Title')['Book-Rating'].mean().reset_index()\n",
    "average_rating.rename(columns={'Book-Rating':'Average-Rating'}, inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 61,
   "metadata": {},
   "outputs": [],
   "source": [
    "num_rating = book_ratings.groupby('Book-Title')['Book-Rating'].count().reset_index()\n",
    "num_rating.rename(columns={'Book-Rating':'Num-Ratings'}, inplace=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 62,
   "metadata": {},
   "outputs": [],
   "source": [
    "popular_df = average_rating.merge(num_rating,on='Book-Title')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 63,
   "metadata": {},
   "outputs": [],
   "source": [
    "popular_df = popular_df[popular_df['Num-Ratings']>=250]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 64,
   "metadata": {},
   "outputs": [],
   "source": [
    "popular_df = popular_df.sort_values(\n",
    "    'Average-Rating',\n",
    "    ascending=False\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 65,
   "metadata": {},
   "outputs": [],
   "source": [
    "popular_df = popular_df.merge(\n",
    "    books,\n",
    "    on='Book-Title'\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 66,
   "metadata": {},
   "outputs": [],
   "source": [
    "popular_df = popular_df.drop_duplicates('Book-Title')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 67,
   "metadata": {},
   "outputs": [],
   "source": [
